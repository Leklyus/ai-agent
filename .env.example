# --- GigaChat (LLM) ---
# Authorization key из личного кабинета GigaChat
GIGACHAT_CREDENTIALS=your-authorization-key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL_CERTS=true

# --- restful-booker (API) ---
BOOKER_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123
BOOKER_TIMEOUT=15
BOOKER_MAX_RETRIES=2

# --- агент ---
AGENT_MAX_STEPS=6
AGENT_TEMPERATURE=0.0
AGENT_LLM_TIMEOUT=60
AGENT_VERBOSE=false
